{
  "name": "ai-video-factory",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/api",
    "build": "npm run build --workspace apps/api",
    "typecheck": "npm run typecheck --workspace apps/api",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspace apps/api"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
